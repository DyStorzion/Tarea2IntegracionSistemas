# Todo tiene un default razonable para que `docker compose up` funcione sin .env.

# Único puerto publicado al exterior (Kong)
GATEWAY_PORT=8000

# Contraseña de los Postgres (uno por servicio)
POSTGRES_PASSWORD=cowork

# D-20: con false, reservas llama a Acceso sin Circuit Breaker ni Bulkhead
RESILIENCE_ENABLED=true

# D-48: parámetros de resiliencia. Todos tienen su valor acordado por defecto en el compose;
# descomenta uno solo para un experimento (p. ej. un timeout más corto o un cupo de bulkhead menor).
# Los TIMEOUT_* aplican a reservas y al BFF.
#TIMEOUT_CONEXION_S=0.5
#TIMEOUT_ESPACIOS_S=1
#TIMEOUT_PAGOS_S=2
#TIMEOUT_ACCESO_S=1.5
#TIMEOUT_COMPENSACION_S=5
#RETRY_PASOS_INTENTOS=2
#RETRY_COMPENSACION_INTENTOS=3
#RETRY_COMPENSACION_ESPERA_S=0.2
#CB_VENTANA=10
#CB_MINIMO_LLAMADAS=5
#CB_UMBRAL_FALLOS=0.5
#CB_ESPERA_ABIERTO_S=10
#BULKHEAD_ACCESO_CUPOS=5
#POOL_CONEXIONES=20

# Los secretos JWT NO se configuran aquí: Kong los lee literales de gateway/kong.yml
# y scripts/generar_token.py / k6/lib/token.js usan los mismos valores.
