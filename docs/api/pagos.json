{
  "openapi": "3.1.0",
  "info": {
    "title": "Servicio Pagos (pasarela simulada)",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/cobros": {
      "post": {
        "summary": "Cobrar",
        "description": "Paso 2 de la Saga. Idempotente: el mismo saga_id nunca genera dos cobros.",
        "operationId": "cobrar_cobros_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CobroIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CobroOut"
                }
              }
            }
          },
          "200": {
            "description": "Repetición con el mismo saga_id: devuelve el cobro existente, sin cobrar de nuevo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CobroOut"
                }
              }
            }
          },
          "402": {
            "description": "PAGO_RECHAZADO",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "409": {
            "description": "SAGA_ANULADA",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "ERROR_SIMULADO (modo error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "503": {
            "description": "SERVICIO_NO_DISPONIBLE (modo down)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cobros/{saga_id}/reembolso": {
      "post": {
        "summary": "Reembolsar",
        "description": "Compensación del paso 2. Responde 200 salvo falla inyectada.\n\n- Cobro existente: queda REEMBOLSADO (si ya lo estaba, no hace nada).\n- Sin cobro para ese saga_id: registra la saga como ANULADA.",
        "operationId": "reembolsar_cobros__saga_id__reembolso_post",
        "parameters": [
          {
            "name": "saga_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Saga Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReembolsoOut"
                }
              }
            }
          },
          "500": {
            "description": "ERROR_SIMULADO (modo error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "503": {
            "description": "SERVICIO_NO_DISPONIBLE (modo down)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cobros/{saga_id}": {
      "get": {
        "summary": "Obtener",
        "description": "Consulta usada por el BFF.",
        "operationId": "obtener_cobros__saga_id__get",
        "parameters": [
          {
            "name": "saga_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Saga Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CobroOut"
                }
              }
            }
          },
          "404": {
            "description": "COBRO_NO_EXISTE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "500": {
            "description": "ERROR_SIMULADO (modo error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "503": {
            "description": "SERVICIO_NO_DISPONIBLE (modo down)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorRespuesta"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/chaos": {
      "get": {
        "summary": "Ver Chaos",
        "description": "Modo de falla activo.",
        "operationId": "ver_chaos_admin_chaos_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChaosOut"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Chaos",
        "description": "Cambia el modo de falla. Afecta solo a las rutas de negocio (no a /health, /metrics ni /admin).",
        "operationId": "chaos_admin_chaos_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChaosIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChaosOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChaosIn": {
        "properties": {
          "modo": {
            "$ref": "#/components/schemas/ModoChaos"
          },
          "delay_ms": {
            "type": "integer",
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Delay Ms",
            "description": "Solo aplica al modo slow",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "modo"
        ],
        "title": "ChaosIn"
      },
      "ChaosOut": {
        "properties": {
          "modo": {
            "$ref": "#/components/schemas/ModoChaos"
          },
          "delay_ms": {
            "type": "integer",
            "title": "Delay Ms"
          }
        },
        "type": "object",
        "required": [
          "modo",
          "delay_ms"
        ],
        "title": "ChaosOut"
      },
      "CobroIn": {
        "properties": {
          "saga_id": {
            "type": "string",
            "title": "Saga Id"
          },
          "cliente_id": {
            "type": "string",
            "title": "Cliente Id"
          },
          "monto": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Monto",
            "description": "Monto en pesos; lo informa Espacios al reservar"
          }
        },
        "type": "object",
        "required": [
          "saga_id",
          "cliente_id",
          "monto"
        ],
        "title": "CobroIn",
        "examples": [
          {
            "cliente_id": "cliente-demo",
            "monto": 15000,
            "saga_id": "3f6c2a9e-8d1b-4c1e-9a57-2b0f6f1d7c42"
          }
        ]
      },
      "CobroOut": {
        "properties": {
          "saga_id": {
            "type": "string",
            "title": "Saga Id"
          },
          "cobro_id": {
            "type": "string",
            "title": "Cobro Id",
            "description": "Identificador del cobro en la pasarela"
          },
          "cliente_id": {
            "type": "string",
            "title": "Cliente Id"
          },
          "monto": {
            "type": "integer",
            "title": "Monto"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoCobro"
          },
          "actualizado_en": {
            "type": "string",
            "format": "date-time",
            "title": "Actualizado En"
          }
        },
        "type": "object",
        "required": [
          "saga_id",
          "cobro_id",
          "cliente_id",
          "monto",
          "estado",
          "actualizado_en"
        ],
        "title": "CobroOut"
      },
      "Error": {
        "properties": {
          "codigo": {
            "type": "string",
            "title": "Codigo",
            "examples": [
              "PAGO_RECHAZADO"
            ]
          },
          "mensaje": {
            "type": "string",
            "title": "Mensaje",
            "examples": [
              "La pasarela rechazó el cobro"
            ]
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "mensaje"
        ],
        "title": "Error"
      },
      "ErrorRespuesta": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorRespuesta"
      },
      "EstadoCobro": {
        "type": "string",
        "enum": [
          "COBRADO",
          "REEMBOLSADO"
        ],
        "title": "EstadoCobro"
      },
      "EstadoReembolso": {
        "type": "string",
        "enum": [
          "REEMBOLSADO",
          "ANULADO"
        ],
        "title": "EstadoReembolso"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModoChaos": {
        "type": "string",
        "enum": [
          "ok",
          "slow",
          "error",
          "down"
        ],
        "title": "ModoChaos"
      },
      "ReembolsoOut": {
        "properties": {
          "saga_id": {
            "type": "string",
            "title": "Saga Id"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoReembolso"
          }
        },
        "type": "object",
        "required": [
          "saga_id",
          "estado"
        ],
        "title": "ReembolsoOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
